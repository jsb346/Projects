import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# Load cleaned data
df = pd.read_csv("../data/mlb_hitting_cleaned.csv")

# Display basic info
print(df.info())
print(df.describe())

# Histogram of Exit Velocity
sns.histplot(df["launch_speed"], bins=20, kde=True)
plt.title("Distribution of Exit Velocity")
plt.xlabel("Exit Velocity (mph)")
plt.show()
